page {
  --canvas: #faf9f5;
  --surface: #f5f0e8;
  --surface-strong: #e8e0d2;
  --ink: #141413;
  --body: #3d3d3a;
  --muted: #6c6a64;
  --hairline: #e2dcd3;
  --coral: #cc785c;
  --coral-active: #a9583e;
  --dark: #181715;
  --success: #3e7d50;
  --warning: #9a6712;
  --error: #b33e3e;
  min-height: 100%;
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button,
input {
  border-radius: 0;
  letter-spacing: 0;
}

button::after {
  border-radius: 0;
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding-bottom: calc(146rpx + env(safe-area-inset-bottom));
}

.page-scroll {
  height: 100vh;
}

.page-header {
  padding: calc(24rpx + env(safe-area-inset-top)) 32rpx 28rpx;
  border-bottom: 1rpx solid var(--hairline);
  background: var(--canvas);
}

.page-eyebrow {
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 600;
}

.page-title {
  margin-top: 10rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 54rpx;
  font-weight: 400;
  line-height: 1.15;
}

.page-subtitle {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.section {
  padding: 36rpx 32rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
}

.section-meta {
  color: var(--muted);
  font-size: 22rpx;
}

.button-primary,
.button-secondary,
.button-danger,
.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 30rpx;
  border: 1rpx solid transparent;
  border-radius: 0;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
}

.button-primary {
  background: var(--coral);
  color: #ffffff;
}

.button-primary.button-hover {
  background: var(--coral-active);
}

.button-secondary {
  border-color: var(--ink);
  background: transparent;
  color: var(--ink);
}

.button-danger {
  border-color: var(--error);
  background: transparent;
  color: var(--error);
}

.icon-button {
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  border-color: var(--hairline);
  background: transparent;
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 400;
}

.button-primary[disabled],
.button-secondary[disabled],
.button-danger[disabled] {
  border-color: var(--hairline);
  background: var(--surface);
  color: #98948c;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--body);
  font-size: 24rpx;
  font-weight: 600;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--hairline);
  border-radius: 0;
  background: #ffffff;
  color: var(--ink);
  font-size: 27rpx;
}

.field-input:focus {
  border-color: var(--ink);
}

.list-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  border-top: 1rpx solid var(--hairline);
}

.list-row:first-child {
  border-top: 0;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-caption {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-value {
  margin-left: 20rpx;
  color: var(--body);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 24rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  background: var(--success);
}

.status-dot.is-off {
  background: var(--muted);
}

.empty-state {
  padding: 64rpx 0;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.loading-line {
  height: 24rpx;
  margin: 14rpx 0;
  background: var(--surface-strong);
  opacity: 0.65;
}

.loading-line.is-short {
  width: 48%;
}

.safe-top {
  height: env(safe-area-inset-top);
}
