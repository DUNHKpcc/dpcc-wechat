page {
  background: #faf9f5;
}

.legal-page {
  min-height: 100vh;
  padding: 0 32rpx calc(56rpx + env(safe-area-inset-bottom));
  color: #181715;
}

.legal-header {
  padding: 54rpx 0 38rpx;
  border-bottom: 2rpx solid #181715;
}

.legal-eyebrow,
.section-index,
.legal-meta,
.footer-brand {
  font-family: "SFMono-Regular", Consolas, monospace;
}

.legal-eyebrow {
  display: block;
  color: #a9583e;
  font-size: 20rpx;
  font-weight: 600;
}

.legal-title {
  display: block;
  margin-top: 16rpx;
  font-family: Georgia, "Songti SC", serif;
  font-size: 58rpx;
  line-height: 1.18;
}

.legal-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  color: #79756e;
  font-size: 19rpx;
}

.important-notice {
  padding: 30rpx 0 34rpx;
  border-bottom: 1rpx solid #d9d3ca;
}

.notice-title {
  display: block;
  color: #a9583e;
  font-size: 27rpx;
  font-weight: 700;
}

.notice-copy {
  display: block;
  margin-top: 12rpx;
  color: #45423d;
  font-size: 24rpx;
  line-height: 1.75;
}

.legal-section {
  position: relative;
  padding: 38rpx 0 40rpx 64rpx;
  border-bottom: 1rpx solid #d9d3ca;
}

.section-index {
  position: absolute;
  top: 43rpx;
  left: 0;
  color: #cc785c;
  font-size: 19rpx;
  font-weight: 700;
}

.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.paragraph {
  display: block;
  margin-top: 14rpx;
  color: #4c4943;
  font-size: 24rpx;
  line-height: 1.82;
}

.data-item {
  padding: 24rpx 0 26rpx;
  border-top: 1rpx solid #e5dfd6;
}

.data-item:first-of-type {
  padding-top: 4rpx;
  border-top: 0;
}

.data-name {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
}

.data-detail {
  display: block;
  margin-top: 10rpx;
  color: #5f5b54;
  font-size: 23rpx;
  line-height: 1.75;
}

.rule-list {
  margin-top: 16rpx;
}

.rule-list text {
  display: block;
  margin-top: 10rpx;
  color: #4c4943;
  font-size: 24rpx;
  line-height: 1.7;
}

.legal-footer {
  display: flex;
  align-items: center;
  padding: 44rpx 0 12rpx;
}

.footer-logo {
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
}

.footer-brand,
.footer-contact {
  display: block;
}

.footer-brand {
  font-size: 21rpx;
  font-weight: 700;
}

.footer-contact {
  margin-top: 5rpx;
  color: #79756e;
  font-size: 20rpx;
}
