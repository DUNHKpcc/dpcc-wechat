<view class="login-page">
  <view class="login-masthead" style="padding-top: {{headerInset}}px;">
    <view class="brand-line">
      <button
        class="login-back"
        bindtap="onBack"
        aria-label="返回上一页"
      >
        ←
      </button>
      <image
        class="brand-logo"
        src="/assets/dpcc-logo.png"
        mode="aspectFit"
        aria-label="个人用量工具"
      />
      <text class="brand-name">个人用量工具</text>
    </view>
    <view class="masthead-copy">
      <text class="masthead-eyebrow">PERSONAL TOOL</text>
      <text class="masthead-title">你的用量，清楚可见。</text>
      <text class="masthead-body">查看额度、订阅、模型与密钥。</text>
    </view>
  </view>

  <view class="login-panel" wx:if="{{!loading}}">
    <view class="login-heading">登录后使用</view>
    <view class="login-caption">先浏览公开内容，需要账户功能时再登录。</view>

    <view class="consent-row">
      <view
        class="checkbox {{agreed ? 'is-checked' : ''}}"
        bindtap="onToggleConsent"
        role="checkbox"
        aria-checked="{{agreed}}"
        aria-label="同意用户协议与隐私政策"
      >
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <view class="consent-copy">
        <text bindtap="onToggleConsent">我已阅读并同意</text>
        <text class="consent-link" catchtap="onOpenUserAgreement">《用户服务协议》</text>
        <text>与</text>
        <text class="consent-link" catchtap="onOpenPrivacyPolicy">《隐私政策》</text>
      </view>
    </view>

    <button
      class="button-primary login-button"
      hover-class="button-hover"
      disabled="{{!agreed || submitting}}"
      loading="{{submitting}}"
      open-type="agreePrivacyAuthorization"
      bindtap="onLoginTap"
      bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
    >
      微信登录
    </button>
    <view class="error-message" wx:if="{{errorMessage}}">{{errorMessage}}</view>
    <view class="security-note">协议版本 2026-07-26 · Access Token 不写入本地存储</view>
  </view>

  <view class="login-panel" wx:else>
    <view class="loading-line"></view>
    <view class="loading-line is-short"></view>
  </view>
</view>
